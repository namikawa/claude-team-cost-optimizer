{
  "manifest_version": 3,
  "name": "seat-analyzer export",
  "version": "1.0",
  "description": "claude.ai の管理画面から seat-analyzer 用の CSV をエクスポートする",
  "key": "",
  "permissions": [
    "cookies",
    "downloads",
    "tabs",
    "storage",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "trigger.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "run.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
