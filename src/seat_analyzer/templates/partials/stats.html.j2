
{% if stats %}
<section class="card">
  <div class="card-hd">
    <div class="hd-main"><h2><!--text:h_stats--></h2></div>
    <div class="hd-note">母集団は組織内に閉じています</div>
  </div>
  <div class="tablebox">
    <table>
      <thead><tr><th>指標</th><th class="num">n</th><th class="num">平均</th><th class="num">中央値</th><th class="num">標準偏差</th><th class="num">p25</th><th class="num">p75</th><th class="num">p90</th><th class="num">最大</th></tr></thead>
      <tbody>
{% for d in stats %}      <tr><td>{{ d.label }}</td><td class="num sub">{{ d.n }}</td><td class="num">{{ d.mean_fmt }}</td><td class="num">{{ d.median_fmt }}</td><td class="num sub">{{ d.std_fmt }}</td><td class="num sub">{{ d.p25_fmt }}</td><td class="num sub">{{ d.p75_fmt }}</td><td class="num sub">{{ d.p90_fmt }}</td><td class="num">{{ d.max_fmt }}</td></tr>
{% endfor %}      </tbody>
    </table>
  </div>
  <div class="card-bd">
    <ul class="notes">
      <li><!--text:note_stats_population-->。</li>
      <li><!--text:note_stats_skew-->。</li>
      <li><!--text:note_stats_censored-->。</li>
      <li><!--text:note_stats_loc-->。</li>
      <li><!--text:note_stats_scope-->。</li>
    </ul>
  </div>
</section>
{% endif %}
