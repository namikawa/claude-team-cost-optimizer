
{% if grant_candidates %}
<section class="card">
  <div class="card-hd"><div class="hd-main"><h2><!--text:h_grant--></h2></div></div>
  <div class="card-bd">
{% for c in grant_candidates %}    <div class="callout"><span class="uname" title="{{ c.email }}">{{ c.email.split('@')[0] }}</span>（クレジット{{ c.mode_label }}・モデル超過見込み {{ c.added_fmt }}/月）</div>
{% endfor %}    <p class="lead">昇格の前に、まず上限つき追加クレジット（推奨初期上限 {{ grant_cap_fmt }}）を付与し、1ヶ月の課金実測で判断することを推奨します。</p>
  </div>
</section>
{% endif %}
