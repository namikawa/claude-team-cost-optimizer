
{% if trend %}
<section class="card">
  <div class="card-hd">
    <div class="hd-main"><h2>前月からの変化</h2></div>
    <div class="hd-note">比較対象: {{ trend.compare_month }}{% if trend.gap_skipped %}（直前月が欠測のため直前の存在月と比較）{% endif %}</div>
  </div>
  <div class="card-bd">
{% for g in trend.groups %}    <div class="prev-group">
      <div class="prev-hd"><span class="kind {{ g.cls }}">{{ g.kind }}</span><span class="prev-n">{{ g.people|length }} 名</span></div>
{% if g.people %}      <div class="people">{% for p in g.people %}<div class="person"><span class="who" title="{{ p.email }}">{{ p.email.split('@')[0] }}</span><span class="amount">{{ p.amount_fmt }}</span></div>{% endfor %}</div>
{% else %}      <div class="empty">なし</div>
{% endif %}    </div>
{% endfor %}  </div>
</section>
{% endif %}
