<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Claude Team シート速報プレビュー — {{ scope }}</title>
<style>{{ dashboard_css|safe }}
  {#- 速報専用: 一次判断であることを強調する注意バナー。埋め込む CSS と同じく、
      出力にはコメントを残さないので Jinja のコメントで書く #}
  .banner {
    background: var(--amber-soft); border: 1px solid var(--amber); border-left-width: 5px;
    border-radius: 10px; padding: 14px 18px; font-size: 12.5px; line-height: 1.8;
    color: var(--ink-2);
  }
</style>
<script>{{ dashboard_js|safe }}</script>
</head>
<body>
<header class="topbar">
  <div class="topbar-inner">
    <div class="topbar-row">
      <div class="topbar-left">
        <div class="crumbs"><span class="org">{{ org }}</span><span>{{ month }}</span><span class="sep">/</span><span>Claude Team</span></div>
        <h1 class="page-title">シート速報プレビュー</h1>
      </div>
      <div class="topbar-right">
        <div class="hero"><div class="hero-label">PROJECTED DEMAND</div><div class="hero-value">{{ total_proj_fmt }}</div></div>
        <div class="theme-switch"><button type="button" class="theme-btn" data-theme-set="light" title="ライト">Light</button><button type="button" class="theme-btn" data-theme-set="dark" title="ダーク">Dark</button><button type="button" class="theme-btn is-active" data-theme-set="auto" title="OS設定に追従">Auto</button></div>
      </div>
    </div>
    <div class="tabspacer"></div>
  </div>
</header>
<main class="main">
<div class="stack">
  <div class="banner">{{ days_observed }}日間の観測データ（暦{{ days_in_month }}日、月末ペース換算 ×{{ '%.1f' % factor }}）に基づく一次判断です。シート変更の確定判断には使わず、ヒアリング・観察対象の絞り込みに使ってください。</div>

  <div class="kpis five">
    <div class="kpi"><div class="tag">MEMBERS</div><div class="v">{{ s.n_members }}</div><div class="l">メンバー（Std {{ s.n_standard }} / Prem {{ s.n_premium }}{% if s.n_unassigned %} / 未割当 {{ s.n_unassigned }}{% endif %}）</div></div>
    <div class="kpi"><div class="tag">SEAT COST</div><div class="v">${{ '%.0f' % s.seat_cost_now_usd }}</div><div class="l">現在のシート費用 /月</div></div>
    <div class="kpi"><div class="tag">OBSERVED</div><div class="v">{{ total_obs_fmt }}</div><div class="l">観測需要（{{ days_observed }}日）</div></div>
    <div class="kpi hl"><div class="tag">PROJECTED</div><div class="v">{{ total_proj_fmt }}</div><div class="l">月末ペース換算 /月</div></div>
    <div class="kpi"><div class="tag">BILLED</div><div class="v">{{ s.n_billed }}</div><div class="l">実課金発生</div></div>
  </div>
<!--CREDIT_COMPOSITION-->
  <section class="card">
    <div class="card-hd"><div class="hd-main"><h2>一次判断の内訳</h2></div></div>
    <div class="card-bd">
      <div class="badges">{% for c in label_counts %}<span class="badge {{ c.cls }}">{{ c.label }} {{ c.n }} 名</span>{% endfor %}</div>
    </div>
  </section>

  <section class="card">
    <div class="card-hd">
      <div class="hd-main"><h2>月末ペース換算需要</h2></div>
      <div class="legend"><span><i class="k-std"></i>Standard</span><span><i class="k-prem"></i>Premium</span><span><i class="k-dim"></i>未割当・不明</span></div>
    </div>
    <div class="card-bd bars-bd">
      <div class="bars">
{% for u in users_sorted %}        <div class="bar">
          <div class="name" title="{{ u.email }}">{{ u.email.split('@')[0] }}</div>
          <div class="track"><div class="fill" style="width: {{ '%.1f' % (u.api_cost_projected_usd / max_proj * 100) }}%; background: {{ 'var(--prem)' if u.current_seat == 'premium' else ('var(--dim)' if u.current_seat in ('unassigned', 'unknown') else 'var(--std)') }};"></div></div>
          <div class="val">{{ u.proj_fmt }}</div>
        </div>
{% endfor %}      </div>
    </div>
    <div class="card-ft">棒の色: <span class="seat-standard">■ Standard</span> / <span class="seat-premium">■ Premium</span> / <span class="seat-unassigned">■ 未割当・不明</span></div>
  </section>

  <section class="card">
    <div class="card-hd"><div class="hd-main"><h2>一次判断テーブル</h2></div></div>
    <div class="tablebox tall">
      <table>
        <thead><tr><th>ユーザ</th><th>現シート</th>{% if has_dept %}<th>部署</th>{% endif %}{% if has_team %}<th>チーム</th>{% endif %}<th class="num">{{ obs_label }}</th><th class="num">月末ペース換算</th><th class="num">実課金(観測)</th><th>一次判断</th><th>確度</th></tr></thead>
        <tbody>
{% for u in users_sorted %}        <tr>
          <td class="user" title="{{ u.email }}">{{ u.email.split('@')[0] }}</td>
          <td class="seat"><span class="seat-{{ u.current_seat }}">{{ seat_short.get(u.current_seat, '?') }}</span></td>
          {% if has_dept %}<td class="sub">{{ u.department }}</td>{% endif %}
          {% if has_team %}<td class="sub">{{ u.team }}</td>{% endif %}
          <td class="num sub">{{ u.obs_fmt }}</td>
          <td class="num">{{ u.proj_fmt }}</td>
          <td class="num"{% if u.billed_bg %} style="background:{{ u.billed_bg }}"{% endif %}>{{ u.billed_fmt }}{% if u.billed_flag %} <span class="cap">{{ u.billed_flag }}</span>{% endif %}</td>
          <td class="judge"><span class="badge {{ u.badge_class }}">{{ u.label }}</span></td>
          <td class="judge">{% if u.confidence != '—' %}<span class="conf">{{ u.confidence }}</span>{% endif %}</td>
        </tr>
{% endfor %}        </tbody>
      </table>
    </div>
  </section>
<!--CREDIT_REACH--><!--SNAPSHOT_SECTION--><!--GRANT_SECTION-->
  <section class="card">
    <div class="card-hd"><div class="hd-main"><h2>詳細利用状況（観測値）</h2></div></div>
    <div class="tablebox tall">
      <table>
        <thead><tr><th>ユーザ</th><th class="num">input</th><th class="num">output</th>{% if detail_has_loc %}<th class="num">LoC</th>{% endif %}<th class="num">API換算需要（観測）</th><th>モデル割合（トークン基準）</th><th>product構成（利用回数）</th></tr></thead>
        <tbody>
{% for d in detail_rows %}        <tr><td class="user" title="{{ d.email }}">{{ d.email.split('@')[0] }}</td><td class="num sub">{{ d.in_fmt }}</td><td class="num sub">{{ d.out_fmt }}</td>{% if detail_has_loc %}<td class="num sub">{{ d.loc_fmt }}</td>{% endif %}<td class="num">{{ d.api_fmt }}</td><td class="wrap">{{ d.models }}</td><td class="wrap">{{ d.products }}</td></tr>
{% endfor %}        </tbody>
      </table>
    </div>
    <div class="card-ft">観測値（{{ days_observed }}日分）のままで、月末ペース換算はしていません。{% if detail_has_loc and code_asof %}<br>LoC は {{ code_asof }} 時点の code-analytics スナップショットの累積値です。{% endif %}<br><!--text:note_detail_tokens-->。</div>
  </section>

  <section class="card">
    <div class="card-hd"><div class="hd-main"><h2>注意事項</h2></div></div>
    <div class="card-bd">
      <ul class="notes assumptions">
        <li>日割り換算（×{{ '%.1f' % factor }}）は利用の偏り（曜日・導入直後の立ち上がり・プロジェクト山谷）を補正しません。</li>
        <li><!--text:note_billed_nonlinear-->。</li>
        <li>変更推奨・ヒステリシス判定は行いません。確定判断は全月データ2ヶ月分での正式分析（analyze）で行ってください。</li>
{% if disabled_note %}        <li>{{ disabled_note }}。</li>
{% endif %}        <li><!--text:legend_idle-->。</li>
        <li><!--text:legend_over-->。</li>
        <li><!--text:legend_billed-->。</li>
        <li><!--text:legend_excluded-->。</li>
      </ul>
    </div>
  </section>
</div>
</main>
</body>
</html>
